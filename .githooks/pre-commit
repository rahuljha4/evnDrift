#!/usr/bin/env node
// Enforces docs/conventions/commits.md §1.3 for the checks that need only the staged files.
// No shell constructs: runs the same in Git Bash on Windows. FAST=1 skips tests/typecheck for
// docs-only commits (never for anything else).
import { execFileSync } from 'node:child_process';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';

const root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
const checks = await import(pathToFileURL(join(root, 'scripts/commit-checks/run.mjs')).href);
const { formatFailures } = await import(
  pathToFileURL(join(root, 'scripts/commit-checks/report.mjs')).href
);

const { failures, skipped } = checks.runPreCommit({ root });
for (const s of skipped) console.log(`pre-commit: ${s}`);
if (failures.length) {
  console.error(formatFailures(failures, 'pre-commit blocked the commit'));
  process.exit(1);
}
