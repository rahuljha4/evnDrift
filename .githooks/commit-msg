#!/usr/bin/env node
// Enforces docs/conventions/commits.md §1.1, §1.2, the message-dependent parts of §1.3, and §1.4.
import { execFileSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { pathToFileURL } from 'node:url';

const root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();

// Merge commits are exempt (docs/conventions/commits.md §1.1).
try {
  execFileSync('git', ['rev-parse', '-q', '--verify', 'MERGE_HEAD'], { stdio: 'ignore' });
  process.exit(0);
} catch {
  /* not merging */
}

const file = process.argv[2];
if (!file) {
  console.error('commit-msg: no message file given');
  process.exit(1);
}
const checks = await import(pathToFileURL(join(root, 'scripts/commit-checks/run.mjs')).href);
const { formatFailures } = await import(
  pathToFileURL(join(root, 'scripts/commit-checks/report.mjs')).href
);

const { failures } = checks.runCommitMsg({ raw: readFileSync(file, 'utf8'), root });
if (failures.length) {
  console.error(formatFailures(failures, 'commit-msg blocked the commit'));
  process.exit(1);
}
